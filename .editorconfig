# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.{js,ts,jsx,tsx}]
indent_style = space
indent_size = 2

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{html,css,scss}]
indent_style = space
indent_size = 2

[*.{sh,bash}]
indent_style = space
indent_size = 2

[*.{c,cpp,h,hpp}]
indent_style = space
indent_size = 4

[*.{java,kt}]
indent_style = space
indent_size = 4

[*.{go,rs}]
indent_style = tab

[*.{rb,erb}]
indent_style = space
indent_size = 2

[*.{php,phtml}]
indent_style = space
indent_size = 4

[*.{sql,psql}]
indent_style = space
indent_size = 4

[*.xml]
indent_style = space
indent_size = 2

[*.gradle]
indent_style = space
indent_size = 4

[Dockerfile]
indent_style = space
indent_size = 4

[*.proto]
indent_style = space
indent_size = 2

[*.graphql]
indent_style = space
indent_size = 2
